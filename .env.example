# ====================================
# ITL Website Environment Variables
# ====================================

# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to git!

# ====================================
# GOOGLE ANALYTICS & ADS
# ====================================

# Google Analytics 4 Measurement ID (tracking pixel)
# Get from: https://analytics.google.com → Admin → Data Streams
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads Conversion ID (optional)
# Get from: https://ads.google.com → Tools → Conversions
# Format: AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Google Ads Conversion Labels
# Get from: Google Ads → Goals → Conversions → [Conversion action] → Tag details
# Format: alphanumeric label slug ending with underscore (e.g., LABEL_SLUG_HERE)
# WARNING: Value must be the label slug ONLY. Do NOT include the AW-XXXXXXXXXX/ prefix.
# The code builds send_to as AW-XXXXXXXXXX/LABEL_SLUG at runtime from NEXT_PUBLIC_GOOGLE_ADS_ID.
# Primary conversions (optimized by Smart Bidding)
NEXT_PUBLIC_GOOGLE_ADS_QUOTE_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_MEETING_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_CATALOG_ORDER_LABEL=
# Secondary conversions (observation only)
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_START_PROJECT_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_NEWSLETTER_LABEL=

# ====================================
# FACEBOOK/META PIXEL
# ====================================

# Facebook Pixel ID
# Get from: https://business.facebook.com/events_manager
# Format: 16-digit number
NEXT_PUBLIC_FB_PIXEL_ID=

# ====================================
# LINKEDIN INSIGHT TAG
# ====================================

# LinkedIn Partner ID
# Get from: https://www.linkedin.com/campaignmanager → Insight Tag
# Format: 7-digit number
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# LinkedIn Conversion IDs (optional)
NEXT_PUBLIC_LINKEDIN_LEAD_CONVERSION_ID=
NEXT_PUBLIC_LINKEDIN_CONTACT_CONVERSION_ID=

# ====================================
# TWITTER/X PIXEL
# ====================================

# Twitter Pixel ID
# Get from: https://ads.twitter.com → Events Manager
# Format: 5-character alphanumeric (e.g., abcd1)
NEXT_PUBLIC_TWITTER_PIXEL_ID=

# ====================================
# ADROLL RETARGETING
# ====================================

# AdRoll Advertiser ID
# Get from: https://app.adroll.com → Audiences → Install Pixel
# Format: 20-character alphanumeric
NEXT_PUBLIC_ADROLL_ADV_ID=

# AdRoll Pixel ID
# Format: 20-character alphanumeric
NEXT_PUBLIC_ADROLL_PIX_ID=

# ====================================
# HOTJAR (optional - heatmaps/recordings)
# ====================================

# Hotjar Site ID
# Get from: https://insights.hotjar.com
NEXT_PUBLIC_HOTJAR_ID=

# ====================================
# GOOGLE TAG MANAGER (optional)
# ====================================

# If using GTM instead of direct pixel implementation
# Get from: https://tagmanager.google.com
# Format: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# ====================================
# HUBSPOT (Highly Recommended - B2B CRM)
# ====================================

# HubSpot Portal ID (Hub ID)
# Get from: HubSpot → Settings → Account Setup
# Format: 7-8 digit number
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=

# HubSpot Form IDs (optional - if using native HubSpot forms)
NEXT_PUBLIC_HUBSPOT_QUOTE_FORM_ID=
NEXT_PUBLIC_HUBSPOT_CONTACT_FORM_ID=

# ====================================
# FLODESK (Newsletter Management)
# ====================================

# Flodesk Form ID for Lab Signals newsletter
# Get from: Flodesk → Forms → Copy embed code
# Format: 24-character alphanumeric string
# Default Lab Signals form: 689e278b40db38a14e1ffe6b
NEXT_PUBLIC_FLODESK_FORM_ID=689e278b40db38a14e1ffe6b

# Flodesk API Key (optional - for subscriber verification)
# Get from: Flodesk → Settings → API
# Only needed if implementing server-side subscriber verification
FLODESK_API_KEY=

# ====================================
# LAB SIGNALS PREVIEW
# ====================================

# Password for early preview access to staged Lab Signals articles
# Users can enter this password to unlock articles before their release date
# Default: KristenITL3165!
NEXT_PUBLIC_LAB_SIGNALS_PREVIEW_PASSWORD=KristenITL3165!

# ====================================
# DEVELOPMENT/TESTING
# ====================================

# Disable tracking in development
# Set to 'true' to enable tracking in dev mode
NEXT_PUBLIC_ENABLE_TRACKING_DEV=false

# Debug mode - logs tracking events to console
NEXT_PUBLIC_DEBUG_TRACKING=false
