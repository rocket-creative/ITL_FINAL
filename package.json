{
  "name": "itl-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node -e \"console.log('postbuild: skip next-sitemap; App Router sitemap is src/app/sitemap.ts')\"",
    "lhci": "lhci autorun --config=lighthouserc.json",
    "start": "next start",
    "lint": "eslint",
    "test": "npx --yes vitest@3.2.4 run",
    "test:redirects": "./test-redirects.sh http://localhost:3000",
    "test:redirects:prod": "./test-redirects.sh https://www.genetargeting.com",
    "catalog:transform": "node scripts/transform-smoc-catalog.js",
    "catalog:upload": "node scripts/upload-catalog-to-supabase.js",
    "catalog:refresh": "npm run catalog:transform && npm run catalog:upload",
    "gene-expansion:seed": "node scripts/gene-expansion/seed-genes-from-catalog.js && node scripts/gene-expansion/seed-model-types.js",
    "gene-expansion:ingest": "node scripts/gene-expansion/ingest/run-all.js",
    "gene-expansion:generate": "node scripts/generate-gene-type-pages.js",
    "gene-expansion:lint-copy": "node scripts/lint-build-inquiry-copy.mjs",
    "gene-expansion:pipeline": "npm run gene-expansion:seed && npm run gene-expansion:ingest && npm run gene-expansion:generate && npm run gene-expansion:validate && npm run gene-expansion:lint-copy",
    "gene-expansion:validate": "node scripts/gene-expansion/validate-acceptance.js",
    "check:gsc-404s": "node scripts/check-gsc-404-urls.mjs",
    "submit:google": "node scripts/submit-to-google.js",
    "verify:launch": "node scripts/verify-launch.js",
    "prelaunch": "npm run build && npm run verify-launch"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1",
    "@vercel/analytics": "^1.6.1",
    "@vercel/og": "^0.8.6",
    "gsap": "^3.12.5",
    "mammoth": "^1.11.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@lhci/cli": "0.14.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^9",
    "eslint-config-next": "15.2.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "googleapis": "^144.0.0",
    "next-sitemap": "^4.2.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
